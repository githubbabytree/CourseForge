# Public application configuration
COURSEFORGE_VERSION=v1.0.1
COURSEFORGE_COMPOSE_PROJECT_NAME=courseforge
COURSEFORGE_SITE_ADDRESS=:8080
COURSEFORGE_DEPLOYMENT_PROFILE=development
WEB_PORT=3000
API_PORT=4000
POSTGRES_PASSWORD=change-me-before-running
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-running
COURSEFORGE_PUBLIC_ORIGIN=http://127.0.0.1:3000
COURSEFORGE_CORS_ORIGINS=http://127.0.0.1:3000
COURSEFORGE_SEARCH_EXECUTABLES=/workspace/node_modules/.bin/mcporter
MCPORTER_CONFIG_HOST_PATH=./infra/mcporter.example.json

# Legacy provider examples below are references/placeholders only. Runtime
# bindings are created through the governed admin API. Never commit values.
TEXT_MODEL_BASE_URL=https://example.invalid/v1
TEXT_MODEL_NAME=replace-with-model-id
TEXT_MODEL_SECRET_REF=env://COURSEFORGE_TEXT_PROVIDER_TOKEN
COURSEFORGE_TEXT_PROVIDER_TOKEN=change-me-before-running
MULTIMODAL_MODEL_BASE_URL=https://example.invalid/v1
MULTIMODAL_MODEL_NAME=replace-with-model-id
MULTIMODAL_MODEL_SECRET_REF=env://COURSEFORGE_MULTIMODAL_PROVIDER_TOKEN
COURSEFORGE_MULTIMODAL_PROVIDER_TOKEN=change-me-before-running
COURSEFORGE_DESIGN_PROVIDER_TOKEN=change-me-before-running
SEARCH_PROVIDER=agent-reach
# Set only in an untracked deployment environment. The published search
# provider version should reference it as env://COURSEFORGE_PROVIDER_EXA_VALUE.
COURSEFORGE_PROVIDER_EXA_VALUE=change-me-before-running

# Local infrastructure
DATABASE_URL=postgresql://courseforge:change-me@postgres:5432/courseforge
TEMPORAL_ADDRESS=temporal:7233
S3_ENDPOINT=http://minio:9000
S3_BUCKET=courseforge
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
