COURSEFORGE_VERSION=v1.1.2
COURSEFORGE_COMPOSE_PROJECT_NAME=courseforge
COURSEFORGE_SEARCH_EXECUTABLES=/workspace/node_modules/.bin/mcporter
MCPORTER_CONFIG_HOST_PATH=./mcporter.example.json

# 启动时自动为代码 Catalog 中缺失的业务 Prompt 创建草稿（幂等，只建 draft 不发布）。
# 新装/升级后无需手动初始化；设为 0 或 false 可关闭。
COURSEFORGE_AUTO_INIT_PROMPTS=1
COURSEFORGE_PROVIDER_EXA_VALUE=change-me-before-running
COURSEFORGE_TEXT_PROVIDER_TOKEN=change-me-before-running
COURSEFORGE_MULTIMODAL_PROVIDER_TOKEN=change-me-before-running
COURSEFORGE_DESIGN_PROVIDER_TOKEN=change-me-before-running
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_CONTAINER_PORT=8080
COURSEFORGE_SITE_ADDRESS=:8080
COURSEFORGE_DEPLOYMENT_PROFILE=development
POSTGRES_PASSWORD=change-me-before-running
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-running
COURSEFORGE_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Comma-separated exact browser origins. Defaults to COURSEFORGE_PUBLIC_ORIGIN.
COURSEFORGE_CORS_ORIGINS=http://127.0.0.1:8080
SECURE_COOKIES=false
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=change-me-before-running
MINIO_APP_USER=replace-with-artifact-app-user
MINIO_APP_PASSWORD=change-me-before-running
MINIO_VIDEO_READER_USER=replace-with-video-read-only-user
MINIO_VIDEO_READER_PASSWORD=change-me-before-running
VIDEO_WORKER_AUTH_TOKEN=replace-with-at-least-32-random-characters
VIDEO_WORKER_ENGINE_REVISION=playwright-1.55.0-ffmpeg-noble
VIDEO_WORKER_IMAGE_DIGEST=sha256:replace-with-built-image-digest
VIDEO_RENDER_TIMEOUT_MS=600000
# Optional TTS profile. These are metadata/placeholders only; never put model
# files in the repository. Enabling the profile without every valid pin fails.
TTS_ENGINE=disabled
TTS_ENGINE_REVISION=disabled
TTS_MODEL_ID=disabled
TTS_MODEL_HOST_PATH=./disabled/tts-model.bin
TTS_MODEL_SHA256=disabled
TTS_MODEL_LICENSE=disabled
TTS_VOICE_ID=disabled
TTS_VOICE_DISPLAY_NAME=disabled
TTS_RUNNER_HOST_PATH=./disabled/engine-runner
TTS_WORKER_AUTH_TOKEN=replace-with-at-least-32-random-characters
TTS_SAMPLE_RATE_HZ=24000
TTS_CHANNELS=1
TTS_MAX_AUDIO_BYTES=33554432
TTS_SYNTHESIS_TIMEOUT_SECONDS=120
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=courseforge-artifacts
# Provider credentials are configured by secret reference in the application.
# Never paste API keys into this file or commit a populated .env.
