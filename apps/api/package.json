    "@courseforge/contracts": "1.1.2",
    "@courseforge/deck": "1.1.2",
    "@courseforge/ingestion": "1.1.2",
    "@courseforge/media": "1.1.2",
    "@courseforge/providers": "1.1.2",
    "@courseforge/workflow": "1.1.2",
    "mcporter": "0.9.0",
    "pg": "^8.16.3",
    "sharp": "^0.34.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.15.5",
    "typescript": "^5.7.3"
